# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Only the orchestrator container reads this file. The web container and the sandbox get none of it.

# --- LLM provider ---
# mock  = offline canned replies, labeled [MOCK], no network, no cost (default)
# vultr = Vultr Serverless Inference (OpenAI-compatible)
EIG_LLM_PROVIDER=mock
EIG_MOCK_VERDICT=uncertain     # mock only: tampering | legitimate | uncertain

# --- Vultr Serverless Inference ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Model ids: run `python scripts/list_models.py` and paste the ones you want.
MODEL_REASONING=
MODEL_VISION=                  # empty = OCR text from the sandbox goes to MODEL_REASONING
EIG_RESPONSE_FORMAT=json_schema   # json_schema | json_object | none (if the model rejects schemas)

# --- Human approval ---
# Required to approve/reject a restore. Empty or shorter than 16 chars = approvals disabled (fail closed).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
EIG_APPROVER_TOKEN=
# Judge access: a second token you publish in the submission. Same checks; ledger label "demo:<hash>".
EIG_DEMO_TOKEN=
EIG_AUTO_RESET_MIN=15           # restore certified results + expire pending proposals (0 = off)
EIG_TAMPER_IP_HOURLY_CAP=6      # "Simulate tamper" per visitor IP per hour
EIG_TAMPER_DAILY_CAP=100        # "Simulate tamper" per day, all visitors

# --- Spend and rate caps ---
EIG_PRICE_IN_PER_MTOK=1.00     # USD per 1M prompt tokens, for the cost estimate (set to Vultr's price)
EIG_PRICE_OUT_PER_MTOK=3.00    # USD per 1M completion tokens
EIG_DAILY_SPEND_CAP_USD=2.00   # no new model call once today's estimated spend would pass this
EIG_DAILY_LIVE_CAP=60          # live runs per day, all visitors together
EIG_IP_HOURLY_CAP=6            # live runs per visitor IP per hour
EIG_MAX_CONCURRENT=1           # live runs at once (one sandbox at a time)
EIG_EVAL_MAX_RUNS=30           # eval refuses to start more paid runs than this
EIG_TRUSTED_PROXY_HOPS=1       # dev: browser -> web -> orchestrator = 1; with Caddy (M5) = 2

# --- Sandbox (M3) ---
EIG_SANDBOX_IMAGE=eig-sandbox:latest
EIG_SANDBOX_TIMEOUT_S=60
EIG_EVIDENCE_PATH=auto          # auto | vision | ocr  (auto: vision if MODEL_VISION is set, else OCR)
EIG_SANDBOX_NETWORK=eig_sandbox_net
EIG_COUNTY_URL=http://county-site:8080
