# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Only the orchestrator (app container) reads these. The sandbox container gets NO env vars.

# --- Vultr Serverless Inference (OpenAI-compatible) ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Model ids: run `python scripts/list_models.py` (M2) and paste the ones you want.
MODEL_REASONING=
MODEL_VISION=

# mock = offline canned replies, no network, no cost (default until the key arrives)
# vultr = real calls to Vultr Serverless Inference
EIG_LLM_PROVIDER=mock

# --- Spend and rate caps (live runs) ---
EIG_DAILY_LIVE_CAP=60          # live runs per day, all visitors together
EIG_IP_HOURLY_CAP=6            # live runs per visitor IP per hour
EIG_DAILY_SPEND_CAP_USD=2.00   # stop calling Vultr Inference once today's estimated spend reaches this
EIG_TRUSTED_PROXY_HOPS=1       # Caddy in front of the app = 1 hop

# --- Sandbox (M3) ---
EIG_SANDBOX_IMAGE=eig-sandbox:latest
EIG_SANDBOX_TIMEOUT_S=60
EIG_SANDBOX_NETWORK=eig_sandbox_net
EIG_COUNTY_URL=http://county-site:8080
